# Copy to ~/.cortex/.env (or ./.env) and fill in. Never commit the real file.

# Groq (https://console.groq.com/keys). The free tier works; it is used first.
GROQ_API_KEY=

# Optional second Groq key, used automatically when the first key's daily quota runs out.
GROQ_PAID_API_KEY=

# Optional: use Claude instead (cortex ask ... --provider anthropic)
ANTHROPIC_API_KEY=

# Optional: where the library lives (default ~/.cortex)
# CORTEX_HOME=

# Optional: a local vision model for OCR of handwriting instead of Groq
# (any OpenAI-compatible server, e.g. LM Studio or mlx_vlm.server)
# CORTEX_VLM_BASE_URL=http://127.0.0.1:1234/v1
# CORTEX_VLM_MODEL=qwen2.5-vl-7b-instruct
